# ─── AgriFlow AI — Environment Variables ───────────────────────────────────────
# Copy to .env and fill in your values. Never commit .env to git.

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=agriflow

# JWT Secret — CHANGE THIS in production (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Google Gemini API (Phase 10)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API (Phase 3)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# App
APP_ENV=development
